{
  "name": "insurance-claims-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "contract:emit": "prisma contract emit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "architecture:check": "node scripts/architecture-check.mjs",
    "start:api": "tsx apps/api/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "start:legacy": "tsx apps/legacy-simulator/src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "argon2": "0.45.1",
    "jose": "6.2.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.6.1",
    "@types/supertest": "7.2.1",
    "prisma": "8.0.0-rc.13",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
