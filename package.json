{
  "name": "insurance-claims-mvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "contract:emit": "prisma contract emit",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/**/*.test.ts",
    "api:reconcile:r3": "tsx scripts/reconcile-api-r3.ts",
    "openapi:generate:r3": "node scripts/materialize-openapi-r3.mjs",
    "openapi:check:r3": "node scripts/materialize-openapi-r3.mjs --check",
    "openapi:validate:r3": "node scripts/validate-openapi-r3.mjs .runtime/openapi.bundle.json documentation/api/r3/API_ENDPOINT_INVENTORY_R3.json",
    "postman:generate:r3": "node scripts/materialize-postman-r3.mjs",
    "postman:check:r3": "node scripts/materialize-postman-r3.mjs --check",
    "postman:validate:r3": "node scripts/validate-postman-contract.mjs postman/InsuranceClaims.postman_collection.json postman/InsuranceClaims.local.postman_environment.json documentation/api/r3/API_ENDPOINT_INVENTORY_R3.json && node scripts/validate-postman-r3-historical-compat.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "start:api": "tsx apps/api/src/main.ts",
    "start:mcp": "tsx apps/mcp/src/main.ts",
    "start:legacy": "tsx apps/legacy-simulator/src/main.ts",
    "start:worker": "tsx apps/worker/src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "argon2": "0.45.1",
    "jose": "6.2.11",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "temporal-polyfill": "1.0.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/node": "24.6.1",
    "@types/supertest": "7.2.1",
    "prisma": "8.0.0-rc.13",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "overrides": {
    "multer": "2.3.0"
  }
}
