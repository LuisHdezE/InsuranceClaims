{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "paths": {
      "@insurance/domain": ["./packages/domain/src/index.ts"],
      "@insurance/domain/claim-task": ["./packages/domain/src/claim-task.ts"],
      "@insurance/application": ["./packages/application/src/index.ts"],
      "@insurance/application/claim-evidence-attention": ["./packages/application/src/claim-evidence-attention.ts"],
      "@insurance/application/claim-pipeline": ["./packages/application/src/claim-pipeline.ts"],
      "@insurance/application/claim-tasks": ["./packages/application/src/claim-tasks.ts"],
      "@insurance/application/claim-timeline": ["./packages/application/src/claim-timeline.ts"],
      "@insurance/application/claims-operations": ["./packages/application/src/claims-operations.ts"],
      "@insurance/application/claims-operational-query": ["./packages/application/src/claims-operational-query.ts"],
      "@insurance/application/communication-template-admin": ["./packages/application/src/communication-template-admin.ts"],
      "@insurance/application/communications": ["./packages/application/src/communications.ts"],
      "@insurance/application/customer-policy": ["./packages/application/src/customer-policy.ts"],
      "@insurance/application/integration-auth": ["./packages/application/src/integration-auth.ts"],
      "@insurance/application/integration-events": ["./packages/application/src/integration-events.ts"],
      "@insurance/application/pipeline-admin": ["./packages/application/src/pipeline-admin.ts"],
      "@insurance/infrastructure": ["./packages/infrastructure/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "prisma.config.ts"],
  "exclude": ["dist", "node_modules", "apps/web"]
}
