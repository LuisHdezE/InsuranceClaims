// use prisma-next

enum ClaimStatus {
  @@type("pg/text@1")
  RECEIVED
  UNDER_REVIEW
  OBSERVED
  APPROVED
  IN_REPAIR
  CLOSED
}

enum OperatorRole {
  @@type("pg/text@1")
  CLAIMS_OPERATOR
  CLAIMS_SUPERVISOR
  PLATFORM_ADMIN
}

enum HistoryActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
}

enum AuditActorType {
  @@type("pg/text@1")
  ANONYMOUS
  CUSTOMER_PUBLIC
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
}

enum AuditOutcome {
  @@type("pg/text@1")
  SUCCESS
  FAILURE
}

enum IdempotencyStatus {
  @@type("pg/text@1")
  IN_PROGRESS
  COMPLETED
  FAILED_RETRYABLE
}

enum ClaimTaskType {
  @@type("pg/text@1")
  CLAIM_REVIEW
  EVIDENCE_REVIEW
  MISSING_DOCUMENT_FOLLOWUP
  CUSTOMER_FOLLOWUP
  CLOSURE_REVIEW
}

enum ClaimTaskStatus {
  @@type("pg/text@1")
  OPEN
  COMPLETED
  CANCELLED
}

enum ClaimTaskPriority {
  @@type("pg/text@1")
  NORMAL
  HIGH
}

enum ClaimTaskQueue {
  @@type("pg/text@1")
  CLAIMS
}

enum ClaimTaskActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  AUTOMATION
}

enum ClaimTaskHistoryEventType {
  @@type("pg/text@1")
  CREATED
  ASSIGNED
  UPDATED
  COMPLETED
  CANCELLED
}

enum ClaimTaskCancellationReason {
  @@type("pg/text@1")
  NO_LONGER_REQUIRED
  DUPLICATE
  CREATED_IN_ERROR
}

enum PipelineConsumerType {
  @@type("pg/text@1")
  CLAIM
  RENEWAL
  COLLECTION
}

enum PipelineVersionStatus {
  @@type("pg/text@1")
  DRAFT
  ACTIVE
  RETIRED
}

enum PipelineActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  AUTOMATION
}

model Operator {
  id           Uuid         @id @default(uuid())
  login        String       @unique
  passwordHash String       @map("password_hash")
  role         OperatorRole
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")
  history      ClaimStatusHistory[]

  @@map("operators")
}

model Customer {
  id          Uuid     @id @default(uuid())
  customerRef String   @unique @map("customer_ref")
  displayName String   @map("display_name")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  version     Int      @default(1)
  policies    Policy[]
  claims      Claim[]

  @@index([status], map: "customers_status_idx")
  @@map("customers")
}

model Policy {
  id                    Uuid          @id @default(uuid())
  customerId            Uuid          @map("customer_id")
  policyReference       String        @unique @map("policy_reference")
  legacyPolicyReference String        @map("legacy_policy_reference")
  insurerReference      String?       @map("insurer_reference")
  recordStatus          String        @map("record_status")
  operationalMetadata   Json          @map("operational_metadata")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @map("updated_at")
  version               Int           @default(1)
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assets                PolicyAsset[]
  claims                Claim[]

  @@index([customerId, recordStatus], map: "policies_customer_status_idx")
  @@index([legacyPolicyReference], map: "policies_legacy_reference_idx")
  @@map("policies")
}

model PolicyAsset {
  id                   Uuid     @id @default(uuid())
  policyId             Uuid     @map("policy_id")
  assetType            String   @map("asset_type")
  assetReference       String   @map("asset_reference")
  legacyAssetReference String   @map("legacy_asset_reference")
  metadata             Json
  createdAt            DateTime @default(now()) @map("created_at")
  policy               Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, assetReference], map: "policy_assets_policy_asset_key")
  @@unique([policyId, legacyAssetReference], map: "policy_assets_policy_legacy_asset_key")
  @@index([legacyAssetReference], map: "policy_assets_legacy_reference_idx")
  @@map("policy_assets")
}

model Claim {
  id                    Uuid        @id @default(uuid())
  trackingCode          String      @unique @map("tracking_code")
  policyReference       String      @map("policy_reference")
  vehicleReference      String      @map("vehicle_reference")
  customerId            Uuid?       @map("customer_id")
  policyId              Uuid?       @map("policy_id")
  verifiedCustomerLabel String?     @map("verified_customer_label")
  eventType             String      @map("event_type")
  occurredAt            DateTime    @map("occurred_at")
  locationText          String      @map("location_text")
  description           String
  status                ClaimStatus
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @default(now()) @map("updated_at")
  customer              Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  policy                Policy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)
  history               ClaimStatusHistory[]
  evidence              ClaimEvidence[]
  idempotencyRecords    IdempotencyRecord[]
  tasks                 ClaimTask[]

  @@index([status])
  @@index([createdAt])
  @@index([policyReference, trackingCode])
  @@index([customerId, createdAt], map: "claims_customer_created_idx")
  @@index([policyId, createdAt], map: "claims_policy_created_idx")
  @@map("claims")
}

model ClaimStatusHistory {
  id         Uuid             @id @default(uuid())
  claimId    Uuid             @map("claim_id")
  fromStatus ClaimStatus?     @map("from_status")
  toStatus   ClaimStatus      @map("to_status")
  actorType  HistoryActorType @map("actor_type")
  actorId    Uuid?            @map("actor_id")
  occurredAt DateTime         @map("occurred_at")
  claim      Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor      Operator?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([claimId, occurredAt])
  @@map("claim_status_history")
}

model ClaimEvidence {
  id              Uuid     @id @default(uuid())
  claimId         Uuid     @map("claim_id")
  storageKey      String   @unique @map("storage_key")
  mediaType       String   @map("media_type")
  sizeBytes       BigInt   @map("size_bytes")
  displayFilename String?  @map("display_filename")
  createdAt       DateTime @default(now()) @map("created_at")
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_evidence")
}

model ClaimTask {
  id                 Uuid                        @id @default(uuid())
  claimId            Uuid                        @map("claim_id")
  type               ClaimTaskType
  title              String
  description        String?
  status             ClaimTaskStatus
  priority           ClaimTaskPriority
  queue              ClaimTaskQueue
  assignedOperatorId Uuid?                       @map("assigned_operator_id")
  dueAt              DateTime?                   @map("due_at")
  createdByType      ClaimTaskActorType          @map("created_by_type")
  createdById        Uuid?                       @map("created_by_id")
  sourceKey          String?                     @unique @map("source_key")
  correlationId      String?                     @map("correlation_id")
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @default(now()) @map("updated_at")
  completedAt        DateTime?                   @map("completed_at")
  completedById      Uuid?                       @map("completed_by_id")
  cancelledAt        DateTime?                   @map("cancelled_at")
  cancelledById      Uuid?                       @map("cancelled_by_id")
  cancellationReason ClaimTaskCancellationReason? @map("cancellation_reason")
  claim              Claim                       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  taskHistory        ClaimTaskHistory[]

  @@index([claimId, status, createdAt])
  @@index([status, dueAt])
  @@index([assignedOperatorId, status])
  @@index([priority, status])
  @@map("claim_tasks")
}

model ClaimTaskHistory {
  id                         Uuid                      @id @default(uuid())
  taskId                     Uuid                      @map("task_id")
  eventType                  ClaimTaskHistoryEventType @map("event_type")
  fromStatus                 ClaimTaskStatus?          @map("from_status")
  toStatus                   ClaimTaskStatus?          @map("to_status")
  previousAssignedOperatorId Uuid?                     @map("previous_assigned_operator_id")
  newAssignedOperatorId      Uuid?                     @map("new_assigned_operator_id")
  previousPriority           ClaimTaskPriority?        @map("previous_priority")
  newPriority                ClaimTaskPriority?        @map("new_priority")
  previousDueAt              DateTime?                 @map("previous_due_at")
  newDueAt                   DateTime?                 @map("new_due_at")
  actorType                  ClaimTaskActorType        @map("actor_type")
  actorId                    Uuid?                     @map("actor_id")
  correlationId              String?                   @map("correlation_id")
  occurredAt                 DateTime                  @map("occurred_at")
  metadata                   Json?
  task                       ClaimTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, occurredAt])
  @@map("claim_task_history")
}

model PipelineDefinition {
  id              Uuid                 @id @default(uuid())
  pipelineKey     String               @unique @map("pipeline_key")
  consumerType    PipelineConsumerType @map("consumer_type")
  displayName     String               @map("display_name")
  enabled         Boolean              @default(false)
  activeVersionId Uuid?                @map("active_version_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")
  version         Int                  @default(1)

  @@map("pipeline_definitions")
}

model PipelineVersion {
  id                   Uuid                  @id @default(uuid())
  pipelineDefinitionId Uuid                  @map("pipeline_definition_id")
  versionNumber        Int                   @map("version_number")
  status               PipelineVersionStatus
  createdByType        PipelineActorType     @map("created_by_type")
  createdById          Uuid?                 @map("created_by_id")
  sourceClassification String                @map("source_classification")
  createdAt            DateTime              @default(now()) @map("created_at")
  activatedAt          DateTime?             @map("activated_at")
  retiredAt            DateTime?             @map("retired_at")

  @@unique([pipelineDefinitionId, versionNumber], map: "pipeline_versions_definition_version_key")
  @@map("pipeline_versions")
}

model PipelineStage {
  id                   Uuid     @id @default(uuid())
  pipelineVersionId    Uuid     @map("pipeline_version_id")
  stageKey             String   @map("stage_key")
  displayName          String   @map("display_name")
  sortOrder            Int      @map("sort_order")
  reportingFlags       Json     @map("reporting_flags")
  allowedNextStageKeys Json     @map("allowed_next_stage_keys")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([pipelineVersionId, stageKey], map: "pipeline_stages_version_stage_key")
  @@unique([pipelineVersionId, sortOrder], map: "pipeline_stages_version_sort_key")
  @@map("pipeline_stages")
}

model PipelineWorkItem {
  id                   Uuid                 @id @default(uuid())
  consumerType         PipelineConsumerType @map("consumer_type")
  consumerId           Uuid                 @map("consumer_id")
  pipelineDefinitionId Uuid                 @map("pipeline_definition_id")
  pipelineVersionId    Uuid                 @map("pipeline_version_id")
  currentStageId       Uuid                 @map("current_stage_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @map("updated_at")
  version              Int                  @default(1)

  @@unique([consumerType, consumerId, pipelineDefinitionId], map: "pipeline_work_items_consumer_definition_key")
  @@index([consumerType, currentStageId], map: "pipeline_work_items_consumer_stage_idx")
  @@index([pipelineDefinitionId, currentStageId], map: "pipeline_work_items_definition_stage_idx")
  @@index([consumerType, consumerId], map: "pipeline_work_items_consumer_identity_idx")
  @@map("pipeline_work_items")
}

model PipelineWorkItemHistory {
  id                Uuid              @id @default(uuid())
  workItemId        Uuid              @map("work_item_id")
  fromStageId       Uuid?             @map("from_stage_id")
  toStageId         Uuid              @map("to_stage_id")
  pipelineVersionId Uuid              @map("pipeline_version_id")
  actorType         PipelineActorType @map("actor_type")
  actorId           Uuid?             @map("actor_id")
  correlationId     String?           @map("correlation_id")
  occurredAt        DateTime          @map("occurred_at")

  @@index([workItemId, occurredAt], map: "pipeline_work_item_history_item_occurred_idx")
  @@map("pipeline_work_item_history")
}

model IdempotencyRecord {
  id                 Uuid              @id @default(uuid())
  scope              String
  idempotencyKeyHash String            @map("idempotency_key_hash")
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus
  claimId            Uuid?             @map("claim_id")
  responseReference  Json?             @map("response_reference")
  createdAt          DateTime          @default(now()) @map("created_at")
  expiresAt          DateTime          @map("expires_at")
  claim              Claim?            @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([scope, idempotencyKeyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id         Uuid           @id @default(uuid())
  eventCode  String         @map("event_code")
  occurredAt DateTime       @map("occurred_at")
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  targetType String?        @map("target_type")
  targetId   String?        @map("target_id")
  outcome    AuditOutcome
  requestId  String?        @map("request_id")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([eventCode, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([requestId])
  @@map("audit_events")
}
