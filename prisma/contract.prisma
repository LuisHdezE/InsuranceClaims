// use prisma-next

enum ClaimStatus {
  @@type("pg/text@1")
  RECEIVED
  UNDER_REVIEW
  OBSERVED
  APPROVED
  IN_REPAIR
  CLOSED
}

enum OperatorRole {
  @@type("pg/text@1")
  CLAIMS_OPERATOR
  CLAIMS_SUPERVISOR
  PLATFORM_ADMIN
}

enum HistoryActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
}

enum AuditActorType {
  @@type("pg/text@1")
  ANONYMOUS
  CUSTOMER_PUBLIC
  CUSTOMER_ACCOUNT
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  INTEGRATION
  AUTOMATION
  SYSTEM
}

enum AuditOutcome {
  @@type("pg/text@1")
  SUCCESS
  FAILURE
}

enum IdempotencyStatus {
  @@type("pg/text@1")
  IN_PROGRESS
  COMPLETED
  FAILED_RETRYABLE
}

enum ClaimTaskType {
  @@type("pg/text@1")
  CLAIM_REVIEW
  EVIDENCE_REVIEW
  MISSING_DOCUMENT_FOLLOWUP
  CUSTOMER_FOLLOWUP
  CLOSURE_REVIEW
}

enum ClaimTaskStatus {
  @@type("pg/text@1")
  OPEN
  COMPLETED
  CANCELLED
}

enum ClaimTaskPriority {
  @@type("pg/text@1")
  NORMAL
  HIGH
}

enum ClaimTaskQueue {
  @@type("pg/text@1")
  CLAIMS
}

enum ClaimTaskActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  AUTOMATION
}

enum ClaimTaskHistoryEventType {
  @@type("pg/text@1")
  CREATED
  ASSIGNED
  UPDATED
  COMPLETED
  CANCELLED
}

enum ClaimTaskCancellationReason {
  @@type("pg/text@1")
  NO_LONGER_REQUIRED
  DUPLICATE
  CREATED_IN_ERROR
}

enum PipelineConsumerType {
  @@type("pg/text@1")
  CLAIM
  RENEWAL
  COLLECTION
}

enum PipelineVersionStatus {
  @@type("pg/text@1")
  DRAFT
  ACTIVE
  RETIRED
}

enum PipelineActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  AUTOMATION
}

enum CommunicationChannel {
  @@type("pg/text@1")
  EMAIL
  WHATSAPP
}

enum CommunicationConfigurationStatus {
  @@type("pg/text@1")
  DRAFT
  ACTIVE
  RETIRED
}

enum CommunicationActorType {
  @@type("pg/text@1")
  SYSTEM
  OPERATOR
  SUPERVISOR
  ADMINISTRATOR
  AUTOMATION
}

enum CommunicationStatus {
  @@type("pg/text@1")
  QUEUED
  DELIVERING
  DELIVERED
  FAILED
  CANCELLED
}

enum CommunicationTargetType {
  @@type("pg/text@1")
  CLAIM
  CUSTOMER
}

enum CommunicationAttemptOutcome {
  @@type("pg/text@1")
  IN_PROGRESS
  DELIVERED
  FAILED
}

enum InboundEventIngestionStatus {
  @@type("pg/text@1")
  ACCEPTED
}

enum InboundEventProcessingStatus {
  @@type("pg/text@1")
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum AsyncJobStatus {
  @@type("pg/text@1")
  PENDING
  LEASED
  SUCCEEDED
  FAILED_RETRYABLE
  DEAD_LETTER
  CANCELLED
}

enum AutomationVersionStatus {
  @@type("pg/text@1")
  DRAFT
  ACTIVE
  RETIRED
}

enum AutomationActorType {
  @@type("pg/text@1")
  SYSTEM
  ADMINISTRATOR
  AUTOMATION
}

enum AutomationExecutionStatus {
  @@type("pg/text@1")
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AutomationActionExecutionStatus {
  @@type("pg/text@1")
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum AutomationActionType {
  @@type("pg/text@1")
  CREATE_TASK
  MOVE_OPERATIONAL_STAGE
  REQUEST_COMMUNICATION
  ADD_OPERATIONAL_TAG
  NOTIFY_OPERATOR
  PAUSE_AUTOMATION
  UPDATE_APPROVED_FIELD
  SCHEDULE_CHECK
}

model Operator {
  id           Uuid         @id @default(uuid())
  login        String       @unique
  passwordHash String       @map("password_hash")
  role         OperatorRole
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @default(now()) @map("updated_at")
  history      ClaimStatusHistory[]

  @@map("operators")
}

model Customer {
  id          Uuid     @id @default(uuid())
  customerRef String   @unique @map("customer_ref")
  displayName String   @map("display_name")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")
  version     Int      @default(1)
  policies    Policy[]
  claims      Claim[]

  @@index([status], map: "customers_status_idx")
  @@map("customers")
}

model Policy {
  id                    Uuid          @id @default(uuid())
  customerId            Uuid          @map("customer_id")
  policyReference       String        @unique @map("policy_reference")
  legacyPolicyReference String        @map("legacy_policy_reference")
  insurerReference      String?       @map("insurer_reference")
  recordStatus          String        @map("record_status")
  operationalMetadata   Json          @map("operational_metadata")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @default(now()) @map("updated_at")
  version               Int           @default(1)
  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assets                PolicyAsset[]
  claims                Claim[]

  @@index([customerId, recordStatus], map: "policies_customer_status_idx")
  @@index([legacyPolicyReference], map: "policies_legacy_reference_idx")
  @@map("policies")
}

model PolicyAsset {
  id                   Uuid     @id @default(uuid())
  policyId             Uuid     @map("policy_id")
  assetType            String   @map("asset_type")
  assetReference       String   @map("asset_reference")
  legacyAssetReference String   @map("legacy_asset_reference")
  metadata             Json
  createdAt            DateTime @default(now()) @map("created_at")
  policy               Policy   @relation(fields: [policyId], references: [id], onDelete: Restrict)

  @@unique([policyId, assetReference], map: "policy_assets_policy_asset_key")
  @@unique([policyId, legacyAssetReference], map: "policy_assets_policy_legacy_asset_key")
  @@index([legacyAssetReference], map: "policy_assets_legacy_reference_idx")
  @@map("policy_assets")
}

model Claim {
  id                    Uuid        @id @default(uuid())
  trackingCode          String      @unique @map("tracking_code")
  policyReference       String      @map("policy_reference")
  vehicleReference      String      @map("vehicle_reference")
  customerId            Uuid?       @map("customer_id")
  policyId              Uuid?       @map("policy_id")
  verifiedCustomerLabel String?     @map("verified_customer_label")
  eventType             String      @map("event_type")
  occurredAt            DateTime    @map("occurred_at")
  locationText          String      @map("location_text")
  description           String
  status                ClaimStatus
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @default(now()) @map("updated_at")
  customer              Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  policy                Policy?     @relation(fields: [policyId], references: [id], onDelete: SetNull)
  history               ClaimStatusHistory[]
  evidence              ClaimEvidence[]
  idempotencyRecords    IdempotencyRecord[]
  tasks                 ClaimTask[]

  @@index([status])
  @@index([createdAt])
  @@index([policyReference, trackingCode])
  @@index([customerId, createdAt], map: "claims_customer_created_idx")
  @@index([policyId, createdAt], map: "claims_policy_created_idx")
  @@map("claims")
}

model ClaimStatusHistory {
  id         Uuid             @id @default(uuid())
  claimId    Uuid             @map("claim_id")
  fromStatus ClaimStatus?     @map("from_status")
  toStatus   ClaimStatus      @map("to_status")
  actorType  HistoryActorType @map("actor_type")
  actorId    Uuid?            @map("actor_id")
  occurredAt DateTime         @map("occurred_at")
  claim      Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  actor      Operator?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([claimId, occurredAt])
  @@map("claim_status_history")
}

model ClaimEvidence {
  id              Uuid     @id @default(uuid())
  claimId         Uuid     @map("claim_id")
  storageKey      String   @unique @map("storage_key")
  mediaType       String   @map("media_type")
  sizeBytes       BigInt   @map("size_bytes")
  displayFilename String?  @map("display_filename")
  createdAt       DateTime @default(now()) @map("created_at")
  claim           Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_evidence")
}

model ClaimTask {
  id                 Uuid                         @id @default(uuid())
  claimId            Uuid                         @map("claim_id")
  type               ClaimTaskType
  title              String
  description        String?
  status             ClaimTaskStatus
  priority           ClaimTaskPriority
  queue              ClaimTaskQueue
  assignedOperatorId Uuid?                        @map("assigned_operator_id")
  dueAt              DateTime?                    @map("due_at")
  createdByType      ClaimTaskActorType           @map("created_by_type")
  createdById        Uuid?                        @map("created_by_id")
  sourceKey          String?                      @unique @map("source_key")
  correlationId      String?                      @map("correlation_id")
  version            Int                          @default(1)
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @default(now()) @map("updated_at")
  completedAt        DateTime?                    @map("completed_at")
  completedById      Uuid?                        @map("completed_by_id")
  cancelledAt        DateTime?                    @map("cancelled_at")
  cancelledById      Uuid?                        @map("cancelled_by_id")
  cancellationReason ClaimTaskCancellationReason? @map("cancellation_reason")
  claim              Claim                        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  taskHistory        ClaimTaskHistory[]

  @@index([claimId, status, createdAt])
  @@index([status, dueAt])
  @@index([assignedOperatorId, status])
  @@index([priority, status])
  @@map("claim_tasks")
}

model ClaimTaskHistory {
  id                         Uuid                      @id @default(uuid())
  taskId                     Uuid                      @map("task_id")
  eventType                  ClaimTaskHistoryEventType @map("event_type")
  fromStatus                 ClaimTaskStatus?          @map("from_status")
  toStatus                   ClaimTaskStatus?          @map("to_status")
  previousAssignedOperatorId Uuid?                     @map("previous_assigned_operator_id")
  newAssignedOperatorId      Uuid?                     @map("new_assigned_operator_id")
  previousPriority           ClaimTaskPriority?        @map("previous_priority")
  newPriority                ClaimTaskPriority?        @map("new_priority")
  previousDueAt              DateTime?                 @map("previous_due_at")
  newDueAt                   DateTime?                 @map("new_due_at")
  actorType                  ClaimTaskActorType        @map("actor_type")
  actorId                    Uuid?                     @map("actor_id")
  correlationId              String?                   @map("correlation_id")
  occurredAt                 DateTime                  @map("occurred_at")
  metadata                   Json?
  task                       ClaimTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, occurredAt])
  @@map("claim_task_history")
}

model PipelineDefinition {
  id              Uuid                 @id @default(uuid())
  pipelineKey     String               @unique @map("pipeline_key")
  consumerType    PipelineConsumerType @map("consumer_type")
  displayName     String               @map("display_name")
  enabled         Boolean              @default(false)
  activeVersionId Uuid?                @map("active_version_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")
  version         Int                  @default(1)

  @@map("pipeline_definitions")
}

model PipelineVersion {
  id                   Uuid              @id @default(uuid())
  pipelineDefinitionId Uuid              @map("pipeline_definition_id")
  versionNumber        Int               @map("version_number")
  status               PipelineVersionStatus
  createdByType        PipelineActorType @map("created_by_type")
  createdById          Uuid?             @map("created_by_id")
  sourceClassification String            @map("source_classification")
  createdAt            DateTime          @default(now()) @map("created_at")
  activatedAt          DateTime?         @map("activated_at")
  retiredAt            DateTime?         @map("retired_at")

  @@unique([pipelineDefinitionId, versionNumber], map: "pipeline_versions_definition_version_key")
  @@map("pipeline_versions")
}

model PipelineStage {
  id                   Uuid     @id @default(uuid())
  pipelineVersionId    Uuid     @map("pipeline_version_id")
  stageKey             String   @map("stage_key")
  displayName          String   @map("display_name")
  sortOrder            Int      @map("sort_order")
  reportingFlags       Json     @map("reporting_flags")
  allowedNextStageKeys Json     @map("allowed_next_stage_keys")
  createdAt            DateTime @default(now()) @map("created_at")

  @@unique([pipelineVersionId, stageKey], map: "pipeline_stages_version_stage_key")
  @@unique([pipelineVersionId, sortOrder], map: "pipeline_stages_version_sort_key")
  @@map("pipeline_stages")
}

model PipelineWorkItem {
  id                   Uuid                 @id @default(uuid())
  consumerType         PipelineConsumerType @map("consumer_type")
  consumerId           Uuid                 @map("consumer_id")
  pipelineDefinitionId Uuid                 @map("pipeline_definition_id")
  pipelineVersionId    Uuid                 @map("pipeline_version_id")
  currentStageId       Uuid                 @map("current_stage_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @default(now()) @map("updated_at")
  version              Int                  @default(1)

  @@unique([consumerType, consumerId, pipelineDefinitionId], map: "pipeline_work_items_consumer_definition_key")
  @@index([consumerType, currentStageId], map: "pipeline_work_items_consumer_stage_idx")
  @@index([pipelineDefinitionId, currentStageId], map: "pipeline_work_items_definition_stage_idx")
  @@index([consumerType, consumerId], map: "pipeline_work_items_consumer_identity_idx")
  @@map("pipeline_work_items")
}

model PipelineWorkItemHistory {
  id                Uuid              @id @default(uuid())
  workItemId        Uuid              @map("work_item_id")
  fromStageId       Uuid?             @map("from_stage_id")
  toStageId         Uuid              @map("to_stage_id")
  pipelineVersionId Uuid              @map("pipeline_version_id")
  actorType         PipelineActorType @map("actor_type")
  actorId           Uuid?             @map("actor_id")
  correlationId     String?           @map("correlation_id")
  occurredAt        DateTime          @map("occurred_at")

  @@index([workItemId, occurredAt], map: "pipeline_work_item_history_item_occurred_idx")
  @@map("pipeline_work_item_history")
}

model CommunicationTemplateDefinition {
  id              Uuid                 @id @default(uuid())
  templateKey     String               @unique @map("template_key")
  channel         CommunicationChannel
  enabled         Boolean              @default(false)
  activeVersionId Uuid?                @map("active_version_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @default(now()) @map("updated_at")
  version         Int                  @default(1)

  @@map("communication_template_definitions")
}

model CommunicationTemplateVersion {
  id                   Uuid                             @id @default(uuid())
  templateDefinitionId Uuid                             @map("template_definition_id")
  versionNumber        Int                              @map("version_number")
  subject              String?
  body                 String
  variableSchema       Json                             @map("variable_schema")
  status               CommunicationConfigurationStatus
  sourceClassification String                           @map("source_classification")
  createdByType        CommunicationActorType           @map("created_by_type")
  createdById          Uuid?                            @map("created_by_id")
  createdAt            DateTime                         @default(now()) @map("created_at")
  activatedAt          DateTime?                        @map("activated_at")
  retiredAt            DateTime?                        @map("retired_at")

  @@unique([templateDefinitionId, versionNumber], map: "communication_template_versions_definition_version_key")
  @@map("communication_template_versions")
}

model Communication {
  id                        Uuid                    @id @default(uuid())
  channel                   CommunicationChannel
  templateVersionId         Uuid                    @map("template_version_id")
  contextType               CommunicationTargetType @map("context_type")
  contextId                 Uuid                    @map("context_id")
  customerId                Uuid?                   @map("customer_id")
  destinationRef            String                  @map("destination_ref")
  variableSnapshot          Json                    @map("variable_snapshot")
  status                    CommunicationStatus
  requestIdempotencyKeyHash String                  @unique @map("request_idempotency_key_hash")
  requestFingerprint        String                  @map("request_fingerprint")
  correlationId             String?                 @map("correlation_id")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @default(now()) @map("updated_at")
  deliveredAt               DateTime?               @map("delivered_at")
  failedAt                  DateTime?               @map("failed_at")
  cancelledAt               DateTime?               @map("cancelled_at")
  version                   Int                     @default(1)

  @@index([status, createdAt], map: "communications_status_created_idx")
  @@index([contextType, contextId, createdAt], map: "communications_context_created_idx")
  @@index([customerId, createdAt], map: "communications_customer_created_idx")
  @@map("communications")
}

model CommunicationAttempt {
  id                Uuid                        @id @default(uuid())
  communicationId   Uuid                        @map("communication_id")
  attemptNumber     Int                         @map("attempt_number")
  deliveryIdentity  String                      @unique @map("delivery_identity")
  startedAt         DateTime                    @map("started_at")
  completedAt       DateTime?                   @map("completed_at")
  outcome           CommunicationAttemptOutcome
  providerReference String?                     @map("provider_reference")
  failureCategory   String?                     @map("failure_category")

  @@unique([communicationId, attemptNumber], map: "communication_attempts_communication_number_key")
  @@index([communicationId, startedAt], map: "communication_attempts_communication_started_idx")
  @@map("communication_attempts")
}

model InboundIntegration {
  id                  Uuid           @id @default(uuid())
  integrationKey      String         @unique @map("integration_key")
  keyId               String         @unique @map("key_id")
  enabled             Boolean        @default(false)
  allowedEventSchemas Json           @map("allowed_event_schemas")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @map("updated_at")
  version             Int            @default(1)
  events              InboundEvent[]

  @@map("inbound_integrations")
}

model InboundEvent {
  id               Uuid                         @id @default(uuid())
  integrationId    Uuid                         @map("integration_id")
  externalEventId  String                       @map("external_event_id")
  payloadHash      String                       @map("payload_hash")
  sanitizedPayload Json                         @map("sanitized_payload")
  eventType        String                       @map("event_type")
  ingestionStatus  InboundEventIngestionStatus  @map("ingestion_status")
  processingStatus InboundEventProcessingStatus @map("processing_status")
  correlationId    String?                      @map("correlation_id")
  acceptedAt       DateTime                     @map("accepted_at")
  processedAt      DateTime?                    @map("processed_at")
  failureCategory  String?                      @map("failure_category")
  version          Int                          @default(1)
  integration      InboundIntegration           @relation(fields: [integrationId], references: [id], onDelete: Restrict)

  @@unique([integrationId, externalEventId], map: "inbound_events_integration_external_key")
  @@index([processingStatus, acceptedAt], map: "inbound_events_processing_accepted_idx")
  @@map("inbound_events")
}

model AsyncJob {
  id                  Uuid           @id @default(uuid())
  jobType             String         @map("job_type")
  idempotencyIdentity String         @map("idempotency_identity")
  payload             Json
  status              AsyncJobStatus
  attemptCount        Int            @default(0) @map("attempt_count")
  maxAttempts         Int            @map("max_attempts")
  availableAt         DateTime       @map("available_at")
  leaseOwner          String?        @map("lease_owner")
  leaseExpiresAt      DateTime?      @map("lease_expires_at")
  correlationId       String?        @map("correlation_id")
  lastFailureCategory String?        @map("last_failure_category")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @default(now()) @map("updated_at")
  completedAt         DateTime?      @map("completed_at")
  version             Int            @default(1)

  @@unique([jobType, idempotencyIdentity], map: "async_jobs_type_identity_key")
  @@index([status, availableAt], map: "async_jobs_status_available_idx")
  @@map("async_jobs")
}

model AutomationDefinition {
  id              Uuid     @id @default(uuid())
  ruleKey         String   @unique @map("rule_key")
  displayName     String   @map("display_name")
  enabled         Boolean  @default(false)
  activeVersionId Uuid?    @map("active_version_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @map("updated_at")
  version         Int      @default(1)

  @@map("automation_definitions")
}

model AutomationVersion {
  id                     Uuid                    @id @default(uuid())
  automationDefinitionId Uuid                    @map("automation_definition_id")
  versionNumber          Int                     @map("version_number")
  status                 AutomationVersionStatus
  triggerSchema          Json                    @map("trigger_schema")
  conditionSchema        Json                    @map("condition_schema")
  waitSchema             Json?                   @map("wait_schema")
  actionList             Json                    @map("action_list")
  sourceClassification   String                  @map("source_classification")
  createdByType          AutomationActorType     @map("created_by_type")
  createdById            Uuid?                   @map("created_by_id")
  createdAt              DateTime                @default(now()) @map("created_at")
  activatedAt            DateTime?               @map("activated_at")
  retiredAt              DateTime?               @map("retired_at")

  @@unique([automationDefinitionId, versionNumber], map: "automation_versions_definition_version_key")
  @@index([automationDefinitionId, status], map: "automation_versions_definition_status_idx")
  @@map("automation_versions")
}

model AutomationExecution {
  id                  Uuid                      @id @default(uuid())
  automationVersionId Uuid                      @map("automation_version_id")
  triggerIdentity     String                    @map("trigger_identity")
  idempotencyKey      String                    @unique @map("idempotency_key")
  contextType         String                    @map("context_type")
  contextId           String                    @map("context_id")
  status              AutomationExecutionStatus
  correlationId       String?                   @map("correlation_id")
  startedAt           DateTime                  @map("started_at")
  completedAt         DateTime?                 @map("completed_at")
  failureCategory     String?                   @map("failure_category")
  version             Int                       @default(1)

  @@index([status, startedAt], map: "automation_executions_status_started_idx")
  @@index([automationVersionId, contextType, contextId], map: "automation_executions_version_context_idx")
  @@map("automation_executions")
}

model AutomationActionExecution {
  id                    Uuid                            @id @default(uuid())
  automationExecutionId Uuid                            @map("automation_execution_id")
  actionKey             String                          @map("action_key")
  actionType            AutomationActionType            @map("action_type")
  targetReference       String?                         @map("target_reference")
  idempotencyKey        String                          @unique @map("idempotency_key")
  status                AutomationActionExecutionStatus
  attemptCount          Int                             @default(0) @map("attempt_count")
  startedAt             DateTime?                       @map("started_at")
  completedAt           DateTime?                       @map("completed_at")
  failureCategory       String?                         @map("failure_category")
  resultMetadata        Json                            @map("result_metadata")

  @@unique([automationExecutionId, actionKey], map: "automation_action_executions_execution_action_key")
  @@index([automationExecutionId, status], map: "automation_action_executions_execution_status_idx")
  @@map("automation_action_executions")
}

model IdempotencyRecord {
  id                 Uuid              @id @default(uuid())
  scope              String
  idempotencyKeyHash String            @map("idempotency_key_hash")
  requestFingerprint String            @map("request_fingerprint")
  status             IdempotencyStatus
  claimId            Uuid?             @map("claim_id")
  responseReference  Json?             @map("response_reference")
  createdAt          DateTime          @default(now()) @map("created_at")
  expiresAt          DateTime          @map("expires_at")
  claim              Claim?            @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@unique([scope, idempotencyKeyHash])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AuditEvent {
  id         Uuid           @id @default(uuid())
  eventCode  String         @map("event_code")
  occurredAt DateTime       @map("occurred_at")
  actorType  AuditActorType @map("actor_type")
  actorId    String?        @map("actor_id")
  targetType String?        @map("target_type")
  targetId   String?        @map("target_id")
  outcome    AuditOutcome
  requestId  String?        @map("request_id")
  metadata   Json?
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([eventCode, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([requestId])
  @@map("audit_events")
