NODE_ENV=development
PORT=3000
MCP_PORT=3100
LEGACY_SIMULATOR_PORT=3200
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_claims

# Demo deployment composition. In production demo mode the API uses synthetic
# policy verification and does not require a standalone legacy simulator.
DEMO_MODE=false
LEGACY_SIMULATOR_URL=http://localhost:3200

STAFF_JWT_SECRET=replace-with-a-long-demo-staff-secret
STAFF_JWT_ISSUER=insurance-claims-staff
STAFF_JWT_AUDIENCE=insurance-claims-staff-api
# Transitional internal alias accepted by the runtime when STAFF_JWT_SECRET is absent.
JWT_SECRET=replace-with-a-long-demo-secret

CUSTOMER_JWT_SECRET=replace-with-a-separate-long-demo-customer-secret
CUSTOMER_JWT_ISSUER=insurance-claims-customer
CUSTOMER_JWT_AUDIENCE=insurance-claims-customer-api

# Comma-separated exact origins. Required for DEMO_MODE=true + NODE_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Used by the Vite build. Example production value: https://api.claims.eliasworks.uy
VITE_API_BASE_URL=http://localhost:3000

# Non-demo production persistence paths. Demo mode avoids depending on these
# local paths for evidence/import source bytes because free hosting filesystems
# are ephemeral.
EVIDENCE_STORAGE_DIR=.runtime/evidence
IMPORT_SOURCE_STORAGE_DIR=.runtime/imports

DEMO_OPERATOR_LOGIN=demo.operator@eliasworks.invalid
DEMO_OPERATOR_PASSWORD=change-me-in-local-env
DEMO_SUPERVISOR_LOGIN=demo.supervisor@eliasworks.invalid
DEMO_ADMIN_LOGIN=demo.admin@eliasworks.invalid
DEMO_CUSTOMER_LOGIN=demo.customer@eliasworks.invalid
DEMO_CUSTOMER_PASSWORD=

# One-shot database safety confirmations. Never commit real passwords/secrets.
DEMO_DB_INIT_CONFIRM=
DEMO_SEED_CONFIRM=
