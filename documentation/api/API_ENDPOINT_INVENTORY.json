{
  "contract_revision": "api-v1-r1",
  "blueprint_version": "0.5.2",
  "project": "LuisHdezE/InsuranceClaims",
  "mode": "greenfield",
  "base_path": "/api/v1",
  "request_id_header": "X-Request-Id",
  "problem_media_type": "application/problem+json",
  "auth": {
    "operator_scheme": "Bearer JWT",
    "token_lifetime_seconds": 900,
    "refresh_tokens": false,
    "logout_endpoint": false
  },
  "operations": [
    {
      "operationId": "verifyPolicyVehicle",
      "method": "POST",
      "path": "/api/v1/public/policy-verifications",
      "actor": "Demo Customer",
      "authentication": "anonymous",
      "permission": "claims.intake.create",
      "request_content_type": "application/json",
      "request_schema": "PolicyVehicleVerificationRequest",
      "success_status": 200,
      "success_schema": "PolicyVehicleVerificationResponse",
      "rate_limit": "20 requests/minute/IP",
      "idempotency": "not_required",
      "durable_audit": "not_required",
      "requirements": ["FR-001", "FR-002", "BR-008", "NFR-002", "NFR-014"],
      "use_cases": ["UC-001"],
      "interfaces": ["WEB-002"]
    },
    {
      "operationId": "createClaim",
      "method": "POST",
      "path": "/api/v1/public/claims",
      "actor": "Demo Customer",
      "authentication": "anonymous",
      "permission": "claims.intake.create",
      "request_content_type": "multipart/form-data",
      "request_schema": "CreateClaimRequest",
      "required_headers": ["Idempotency-Key"],
      "success_status": 201,
      "success_schema": "CreateClaimResponse",
      "rate_limit": "5 requests/minute/IP",
      "idempotency": "required",
      "durable_audit": "CLAIM_CREATED",
      "requirements": ["FR-002", "FR-003", "FR-004", "FR-005", "FR-006", "BR-004", "BR-008", "BR-009", "BR-010", "NFR-005", "NFR-007"],
      "use_cases": ["UC-002"],
      "interfaces": ["WEB-003", "WEB-004", "WEB-005"]
    },
    {
      "operationId": "trackClaim",
      "method": "POST",
      "path": "/api/v1/public/claim-tracking",
      "actor": "Demo Customer",
      "authentication": "anonymous",
      "permission": "claims.tracking.read",
      "request_content_type": "application/json",
      "request_schema": "TrackClaimRequest",
      "success_status": 200,
      "success_schema": "CustomerClaimStatusResponse",
      "rate_limit": "20 requests/minute/IP",
      "idempotency": "not_required",
      "durable_audit": "not_required",
      "requirements": ["FR-007", "FR-008", "BR-007", "BR-009", "NFR-002", "NFR-014"],
      "use_cases": ["UC-003"],
      "interfaces": ["WEB-006", "WEB-007"]
    },
    {
      "operationId": "authenticateOperator",
      "method": "POST",
      "path": "/api/v1/operator/auth/login",
      "actor": "Claims Operator",
      "authentication": "anonymous_credentials",
      "permission": null,
      "request_content_type": "application/json",
      "request_schema": "OperatorLoginRequest",
      "success_status": 200,
      "success_schema": "OperatorLoginResponse",
      "rate_limit": "5 requests/minute/IP and 10 requests/15-minutes/normalized-login",
      "idempotency": "not_required",
      "durable_audit": "AUTH_LOGIN_SUCCEEDED on success; AUTH_LOGIN_FAILED attempted on credential failure",
      "requirements": ["FR-009", "NFR-002", "NFR-004", "NFR-007", "NFR-014"],
      "use_cases": ["UC-004"],
      "interfaces": ["WEB-008"]
    },
    {
      "operationId": "listClaims",
      "method": "GET",
      "path": "/api/v1/operator/claims",
      "actor": "Claims Operator",
      "authentication": "Bearer JWT",
      "permission": "claims.backoffice.read",
      "query": ["page", "pageSize", "status"],
      "success_status": 200,
      "success_schema": "ClaimsPageResponse",
      "rate_limit": "120 requests/minute/operator",
      "idempotency": "not_applicable",
      "durable_audit": "not_required",
      "requirements": ["FR-010", "BR-006", "NFR-002"],
      "use_cases": ["UC-005"],
      "interfaces": ["WEB-009"]
    },
    {
      "operationId": "getClaimDetail",
      "method": "GET",
      "path": "/api/v1/operator/claims/{claimId}",
      "actor": "Claims Operator",
      "authentication": "Bearer JWT",
      "permission": "claims.backoffice.read",
      "path_params": ["claimId"],
      "success_status": 200,
      "success_schema": "OperatorClaimDetailResponse",
      "rate_limit": "120 requests/minute/operator",
      "idempotency": "not_applicable",
      "durable_audit": "not_required",
      "requirements": ["FR-011", "BR-001", "BR-002", "BR-003", "BR-005", "BR-006", "NFR-002"],
      "use_cases": ["UC-005"],
      "interfaces": ["WEB-010"]
    },
    {
      "operationId": "downloadClaimEvidence",
      "method": "GET",
      "path": "/api/v1/operator/claims/{claimId}/evidence/{evidenceId}",
      "actor": "Claims Operator",
      "authentication": "Bearer JWT",
      "permission": "claims.backoffice.read",
      "path_params": ["claimId", "evidenceId"],
      "success_status": 200,
      "success_schema": "binary evidence content with allowlisted Content-Type and safe Content-Disposition",
      "rate_limit": "60 requests/minute/operator",
      "idempotency": "not_applicable",
      "durable_audit": "not_required",
      "requirements": ["FR-011", "NFR-002", "NFR-005"],
      "use_cases": ["UC-005"],
      "interfaces": ["WEB-010"]
    },
    {
      "operationId": "transitionClaimStatus",
      "method": "POST",
      "path": "/api/v1/operator/claims/{claimId}/transitions",
      "actor": "Claims Operator",
      "authentication": "Bearer JWT",
      "permission": "claims.backoffice.transition",
      "path_params": ["claimId"],
      "request_content_type": "application/json",
      "request_schema": "TransitionClaimStatusRequest",
      "success_status": 200,
      "success_schema": "TransitionClaimStatusResponse",
      "rate_limit": "60 requests/minute/operator",
      "idempotency": "not_required; expectedFromStatus is mandatory concurrency guard",
      "durable_audit": "CLAIM_STATE_TRANSITIONED",
      "requirements": ["FR-012", "FR-013", "BR-001", "BR-002", "BR-003", "BR-005", "BR-006", "NFR-002", "NFR-007"],
      "use_cases": ["UC-006"],
      "interfaces": ["WEB-010"]
    },
    {
      "operationId": "getLiveness",
      "method": "GET",
      "path": "/health/live",
      "actor": "Runtime Probe",
      "authentication": "anonymous",
      "permission": null,
      "success_status": 200,
      "success_schema": "HealthResponse",
      "rate_limit": "operational local policy",
      "idempotency": "not_applicable",
      "durable_audit": "not_required",
      "requirements": ["FR-019", "NFR-009"],
      "use_cases": ["UC-008"],
      "interfaces": []
    },
    {
      "operationId": "getReadiness",
      "method": "GET",
      "path": "/health/ready",
      "actor": "Runtime Probe",
      "authentication": "anonymous",
      "permission": null,
      "success_status": 200,
      "success_schema": "HealthResponse",
      "rate_limit": "operational local policy",
      "idempotency": "not_applicable",
      "durable_audit": "not_required",
      "requirements": ["FR-019", "NFR-009"],
      "use_cases": ["UC-008"],
      "interfaces": []
    }
  ],
  "permission_matrix": {
    "claims.intake.create": ["verifyPolicyVehicle", "createClaim"],
    "claims.tracking.read": ["trackClaim"],
    "claims.backoffice.read": ["listClaims", "getClaimDetail", "downloadClaimEvidence"],
    "claims.backoffice.transition": ["transitionClaimStatus"],
    "claims.mcp.status.read": ["MCP:get_claim_status"]
  },
  "audit_mapping": {
    "authenticateOperator": ["AUTH_LOGIN_SUCCEEDED", "AUTH_LOGIN_FAILED"],
    "createClaim": ["CLAIM_CREATED"],
    "transitionClaimStatus": ["CLAIM_STATE_TRANSITIONED"]
  },
  "idempotency_matrix": {
    "createClaim": {
      "required": true,
      "header": "Idempotency-Key",
      "key_length": "16..128",
      "retention": "24 hours",
      "same_key_same_fingerprint": "replay original 201 response and set Idempotency-Replayed: true",
      "same_key_different_fingerprint": "409 IDEMPOTENCY_KEY_REUSED",
      "same_key_in_progress": "409 IDEMPOTENCY_IN_PROGRESS"
    },
    "transitionClaimStatus": {
      "required": false,
      "reason": "expectedFromStatus provides explicit stale-state/concurrency conflict behavior"
    }
  },
  "mcp": {
    "tool": "get_claim_status",
    "permission": "claims.mcp.status.read",
    "input": ["trackingCode", "policyReference"],
    "output": "same customer-safe projection/redaction policy as trackClaim",
    "mutation": false,
    "rest_operationId": null
  },
  "change_impact_analysis": {
    "applicable": false,
    "reason": "Initial API baseline; no prior api_gate consumers exist yet."
  }
}
